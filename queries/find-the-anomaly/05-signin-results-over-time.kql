// Suggested account-specific workbook query using raw timestamps.
// Sanitized example values: replace before execution.
let InvestigationStart = datetime(2026-01-01T00:00:00Z);
let InvestigationEnd = datetime(2026-01-08T00:00:00Z);
let TargetAccount = "account-a@example.invalid";
LabSigninLogs_CL
| where TimeGenerated >= InvestigationStart and TimeGenerated < InvestigationEnd
| where UserPrincipalName_s =~ TargetAccount
| where isnotnull(ResultType_d)
| summarize UnsuccessfulSignins = countif(ResultType_d != 0),
            SuccessfulSignins = countif(ResultType_d == 0)
    by bin(TimeGenerated, 5m)
| order by TimeGenerated asc
| render columnchart with (kind=unstacked, title="Account sign-in results")
